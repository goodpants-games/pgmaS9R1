    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug LOVE",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "lovec"
            },
            "cwd": "${workspaceFolder}/app",
            "args": [".", "--debug"],
            "preLaunchTask": "Build assets"
        },
        {
            "name": "Debug assetexport.py",
            "type": "debugpy",
            "request": "launch",
            "program": "tools/assetexport.py",
            "cwd": "${workspaceFolder}"
        }
    ]
}